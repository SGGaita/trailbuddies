{
  "$id": "https://trailbuddies.africa/schema/unit.json",
  "title": "Unit (a stage on a subject trail: items, lessons and a checkpoint)",
  "type": "object",
  "required": ["schema", "id", "subject", "title", "band", "status", "items", "lessons", "checkpoint"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "unit/1" },
    "id": { "$ref": "common.json#/$defs/id" },
    "subject": { "$ref": "common.json#/$defs/id" },
    "title": { "$ref": "common.json#/$defs/text" },
    "band": { "$ref": "common.json#/$defs/band" },
    "status": { "$ref": "common.json#/$defs/status" },
    "summary": { "$ref": "common.json#/$defs/text" },
    "requires": {
      "type": "array",
      "items": { "$ref": "common.json#/$defs/id" },
      "description": "Unit ids that must be finished first (any subject)"
    },
    "items": { "type": "array", "minItems": 3, "items": { "$ref": "item.json" } },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "title", "focus", "exercises"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.json#/$defs/id" },
          "title": { "$ref": "common.json#/$defs/text" },
          "focus": {
            "type": "array",
            "minItems": 0,
            "items": { "$ref": "common.json#/$defs/id" },
            "description": "New items introduced in this lesson"
          },
          "review": {
            "type": "array",
            "items": { "$ref": "common.json#/$defs/id" },
            "description": "Earlier items mixed back in"
          },
          "exercises": {
            "type": "array",
            "minItems": 3,
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": ["type"],
              "additionalProperties": false,
              "properties": {
                "type": { "$ref": "common.json#/$defs/exerciseType" },
                "prompt": { "$ref": "common.json#/$defs/text" },
                "choices": { "type": "integer", "minimum": 2, "maximum": 6 }
              }
            }
          }
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "required": ["review", "game"],
      "additionalProperties": false,
      "properties": {
        "review": { "type": "integer", "minimum": 2, "maximum": 8 },
        "game": { "enum": ["jigsaw", "memory", "sorting-race", "quiz-show", "maze"] }
      }
    },
    "buddy": {
      "type": "object",
      "description": "Unit-specific buddy lines by event",
      "additionalProperties": { "type": "array", "items": { "$ref": "common.json#/$defs/text" } }
    }
  }
}
