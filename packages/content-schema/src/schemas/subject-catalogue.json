{
  "$id": "https://trailbuddies.africa/schema/subject-catalogue.json",
  "title": "Subject catalogue (places on the world map and their units in trail order)",
  "type": "object",
  "required": ["schema", "subjects"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "catalogue/1" },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "place", "island", "units"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.json#/$defs/id" },
          "name": { "$ref": "common.json#/$defs/text" },
          "place": { "$ref": "common.json#/$defs/text" },
          "island": { "$ref": "common.json#/$defs/id" },
          "units": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "title", "band", "status"],
              "additionalProperties": false,
              "properties": {
                "id": { "$ref": "common.json#/$defs/id" },
                "title": { "$ref": "common.json#/$defs/text" },
                "band": { "$ref": "common.json#/$defs/band" },
                "status": { "$ref": "common.json#/$defs/status" },
                "lessons": { "type": "integer", "minimum": 1, "maximum": 8 }
              }
            }
          }
        }
      }
    }
  }
}
