# Local development image for the web app (docker compose --profile web). Not used in
# production: the web app deploys to Vercel. Build context is the repo root.
FROM node:22-slim
ENV NEXT_TELEMETRY_DISABLED=1 \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
WORKDIR /repo

# Install dependencies first (cached until a package.json or the lockfile changes).
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/
COPY packages/api-client/package.json packages/api-client/
COPY packages/content/package.json packages/content/
COPY packages/content-schema/package.json packages/content-schema/
COPY packages/domain/package.json packages/domain/
COPY packages/i18n/package.json packages/i18n/
COPY packages/sync/package.json packages/sync/
COPY packages/tokens/package.json packages/tokens/
RUN pnpm install --frozen-lockfile --filter "@trailbuddies/web..."

# Source. `docker compose up --watch` keeps these folders in sync while you edit.
COPY apps/web apps/web
COPY packages packages

EXPOSE 3000
WORKDIR /repo/apps/web
CMD ["pnpm", "exec", "next", "dev", "--hostname", "0.0.0.0", "--port", "3000"]
