# Copy to infra/.env (never commit it). Used by docker compose.
POSTGRES_DB=trailbuddies
POSTGRES_USER=trailbuddies
# Letters and digits only: the password is pasted unescaped into TB_DATABASE_URL,
# so @ : / # ? % break the connection ("Name or service not known").
POSTGRES_PASSWORD=change-me-locally
# Host port for the db container. Use 5433 if PostgreSQL is already installed on this PC.
POSTGRES_HOST_PORT=5432
# Host port for the web container (docker compose --profile web). Use 3001 to run it beside `pnpm dev`.
WEB_PORT=3000
TB_ENV=development
TB_CORS_ORIGINS=["http://localhost:3000"]
TB_WEB_URL=http://localhost:3000
# Sign-in emails: generic SMTP. Leave as-is locally (Mailpit catches them at http://localhost:8025).
# On the VPS, set your provider's host, port, user and password, and STARTTLS=true.
TB_SMTP_HOST=mailpit
TB_SMTP_PORT=1025
TB_SMTP_STARTTLS=false
# TB_SMTP_USER=
# TB_SMTP_PASSWORD=
# TB_SMTP_FROM=Trailbuddies <hello@trailbuddies.africa>
# Google sign-in stays hidden until both are set (Google Cloud console > OAuth client,
# redirect URI: <TB_WEB_URL>/api/auth/google/callback).
# TB_GOOGLE_CLIENT_ID=
# TB_GOOGLE_CLIENT_SECRET=
# Photos and voice clips. Locally the API keeps them on a Docker volume (nothing to set).
# On the VPS use Cloudflare R2 (docs/r2-setup.md; keys in the password manager, never in git):
# TB_MEDIA_BACKEND=s3
# TB_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# TB_S3_PUBLIC_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# TB_S3_BUCKET=trailbuddies-media
# TB_S3_REGION=auto
# TB_S3_ACCESS_KEY=
# TB_S3_SECRET_KEY=
# TB_MEDIA_SECRET=<long random value>
# VPS only:
# TB_COOKIE_SECURE=true
# API_DOMAIN=api.trailbuddies.africa
# API_IMAGE=ghcr.io/sggaita/trailbuddies-api:latest
# Nightly privacy job (Vercel Cron sends this; the Docker worker doesn't need it).
# CRON_SECRET=<long random value>
# Errors (SAF-07): with a DSN, scrubbed errors go to Sentry; without, to our own log (/errors).
# TB_SENTRY_DSN=
# TB_ERRORS=own
# Closed beta: require an invite code for new families (python -m app.admin codes --new 10).
# TB_BETA_CODE_REQUIRED=true
# Who reviews US consent forms (ONB-06b).
# TB_REVIEW_EMAIL=
