{
  "name": "trailbuddies",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@trailbuddies/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "content:validate": "pnpm --filter @trailbuddies/content validate",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "turbo": "^2.6.0",
    "jest": "^30.2.0"
  }
}
